<%- include('shared/header') %>

<style>
  /* body {
    font-family: Arial, sans-serif;
    background-color: #f8fafc;
    margin: 0;
    padding: 32px;
    color: #333;
  } */
  h2 {
    text-align: center;
    margin-bottom: 32px;
    color: #222;
    margin: 0;
  }
  .container {
    max-width: 700px;
    margin: 0 auto;
  }
  .input-block {
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 24px 28px;
    margin-bottom: 24px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.05);
  }
  .input-block h2 {
    font-size: 20px;
    margin-bottom: 16px;
    color: #1d4ed8; /* Blue */
  }
  label {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
  }
  input[type="text"],
  select {
    width: 100%;
    padding: 10px 12px;
    margin-bottom: 16px;
    border: 1px solid #bbb;
    border-radius: 4px;
    font-size: 14px;
    box-sizing: border-box;
    transition: border-color 0.3s ease;
  }
  input[type="text"]:focus,
  select:focus {
    border-color: #3b82f6; /* Lighter blue */
    outline: none;
  }
  button {
    background-color: #22c55e; /* Green */
    color: white;
    border: none;
    padding: 12px 20px;
    font-weight: 700;
    font-size: 16px;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    user-select: none;
  }
  button:hover,
  button:focus {
    background-color: #16a34a; /* Darker green */
  }
  .btn-back {
  background-color: #007bff;
  border: none;
  color: white;
  padding: 8px 16px;
  font-weight: 600;
  font-size: 14px;
  border-radius: 4px;
  cursor: pointer;
  margin-bottom: 12px;
  margin-top: 12px;
  transition: background-color 0.3s ease;
}

.btn-back:hover {
  background-color: #0056b3;
}
.main-heading{
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 5px;
}

.mode-selector {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin: 20px auto;
  flex-wrap: wrap;
}

.mode-btn {
  background-color: #3b82f6; /* Blue */
  color: white;
  border: none;
  padding: 10px 20px;
  font-weight: 600;
  font-size: 15px;
  border-radius: 6px;
  cursor: pointer;
  transition: background-color 0.3s ease, transform 0.2s ease;
}

.mode-btn:hover {
  background-color: #2563eb;
  transform: translateY(-2px);
}

.mode-btn.active {
  background-color: #22c55e; /* Green when active */
}

</style>
<div class="mode-selector">
  <button id="btn-add" class="mode-btn active">➕ Add Locations</button>
  <button id="btn-edit" class="mode-btn">✏️ Edit Locations</button>
  <button id="btn-delete" class="mode-btn">❌ Delete Locations</button>
</div>

<div class="container" id="container1">
    <div class="main-heading">
        <button class="btn-back" onclick="history.back()">Back</button>
        <h2>Add New Locations</h2>
    </div>

  <!-- Add New Block -->
  <section class="input-block" aria-labelledby="add-block-label">
    <h2 id="add-block-label">Add New Block</h2>
    <form id="form-add-block">
      <label for="block-name">Block Name</label>
      <input type="text" id="block-name" name="block-name" placeholder="Enter new block name" required />
      <button type="submit">Add Block</button>
    </form>
  </section>

  <!-- Add New Nyay Panchayat -->
  <section class="input-block" aria-labelledby="add-panchayat-label">
    <h2 id="add-panchayat-label">Add New Nyay Panchayat</h2>
    <form id="form-add-panchayat">
      <label for="block-select-panchayat">Select Block</label>
      <select id="block-select-panchayat" name="select-block-for-panchayat" required>
        <option value="" disabled selected>Choose a block</option>
        <!-- Dynamically populate blocks here -->
      </select>
      
      <label for="panchayat-name">Nyay Panchayat Name</label>
      <input type="text" id="panchayat-name" name="panchayat-name" placeholder="Enter new Nyay Panchayat name" required />
      <button type="submit">Add Nyay Panchayat</button>
    </form>
  </section>

  <!-- Add New Village -->
  <section class="input-block" aria-labelledby="add-village-label">
    <h2 id="add-village-label">Add New Village</h2>
    <form id="form-add-village">
      <label for="block-select-village">Select Block</label>
      <select id="block-select-village" name="select-block-for-village" required>
        <option value="" disabled selected>Choose a block</option>
        <!-- Dynamically populate blocks here -->
      </select>

      <label for="nyaypanchayat-select">Select Nyay Panchayat</label>
      <select id="nyaypanchayat-select" name="select-panchayat-for-village" required disabled>
        <option value="" disabled selected>Choose a Nyay Panchayat</option>
        <!-- Dynamically populate Panchayats after block selection -->
      </select>
      
      <label for="village-name">Village Name</label>
      <input type="text" id="village-name" name="village-name" placeholder="Enter new village name" required />
      <button type="submit">Add Village</button>
    </form>
  </section>
</div>

<div class="container" id="container2">
  <div class="main-heading">
    <button class="btn-back" onclick="history.back()">Back</button>
    <h2>Edit Existing Locations</h2>
  </div>

  <!-- 🟦 Edit Block -->
  <section class="input-block" aria-labelledby="edit-block-label">
    <h2 id="edit-block-label">Edit Block Name</h2>
    <form id="form-edit-block">
      <label for="edit-block-select">Select Block</label>
      <select id="edit-block-select" required>
        <option value="" disabled selected>Choose a block</option>
      </select>

      <label for="edit-block-name">New Block Name</label>
      <input type="text" id="edit-block-name" placeholder="Enter new block name" required />

      <button type="submit">Update Block</button>
    </form>
  </section>

  <!-- 🟩 Edit Nyay Panchayat -->
  <section class="input-block" aria-labelledby="edit-panchayat-label">
    <h2 id="edit-panchayat-label">Edit Nyay Panchayat Name</h2>
    <form id="form-edit-panchayat">
      <label for="edit-panchayat-block">Select Block</label>
      <select id="edit-panchayat-block" required>
        <option value="" disabled selected>Choose a block</option>
      </select>

      <label for="edit-panchayat-select">Select Nyay Panchayat</label>
      <select id="edit-panchayat-select" required disabled>
        <option value="" disabled selected>Choose a Nyay Panchayat</option>
      </select>

      <label for="edit-panchayat-name">New Nyay Panchayat Name</label>
      <input type="text" id="edit-panchayat-name" placeholder="Enter new name" required />

